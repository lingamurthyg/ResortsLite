# Azure Environment Variables Template
# Copy this file to .env and fill in your Azure resource values
# DO NOT commit .env file to version control

# Server Configuration
PORT=8080

# Azure Storage Configuration (cr-java-0061, cr-java-0062, cr-java-0063)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your-storage-account>;AccountKey=<your-key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=reports

# Azure Key Vault Configuration (cr-java-0069)
AZURE_KEYVAULT_URI=https://<your-keyvault-name>.vault.azure.net/

# Azure Service Bus Configuration (cr-java-0111)
AZURE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://<your-namespace>.servicebus.windows.net/;SharedAccessKeyName=<key-name>;SharedAccessKey=<key>
AZURE_SERVICEBUS_QUEUE_NAME=scheduled-reports

# Azure Cache for Redis Configuration (cr-java-0065, cr-java-0067)
AZURE_REDIS_HOST=<your-redis-name>.redis.cache.windows.net
AZURE_REDIS_PORT=6380
AZURE_REDIS_PASSWORD=<your-redis-key>
AZURE_REDIS_SSL=true
AZURE_REDIS_TIMEOUT=2000

# Azure Active Directory Configuration (cr-java-0090)
AZURE_AD_CLIENT_ID=<your-app-registration-client-id>
AZURE_AD_TENANT_ID=<your-tenant-id>
AZURE_AD_CLIENT_SECRET=<your-client-secret>

# Database Configuration
AZURE_DB_URL=jdbc:h2:mem:resortdb;DB_CLOSE_DELAY=-1
AZURE_DB_USERNAME=sa
AZURE_DB_PASSWORD=

# Application Endpoints (cr-java-0071)
APP_PAYMENT_ENDPOINT=https://payment-service.azurewebsites.net/charge
APP_INVENTORY_ENDPOINT=https://inventory-service.azurewebsites.net/rooms
APP_NOTIFICATION_ENDPOINT=https://notification-service.azurewebsites.net/send
APP_REPORT_BASE_URL=https://reports.azurewebsites.net

# Azure App Configuration (cr-java-0071)
AZURE_APP_CONFIG_ENABLED=false
AZURE_APP_CONFIG_ENDPOINT=https://<your-appconfig-name>.azconfig.io

# H2 Console (disable in production)
H2_CONSOLE_ENABLED=false

# Spring Security
SPRING_SECURITY_ENABLED=false
