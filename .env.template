# Cloud-Ready Environment Configuration Template
# Copy this file to .env and configure for your environment

# Server Configuration
SERVER_PORT=8080

# Database Configuration (or use AWS Secrets Manager)
DB_URL=jdbc:postgresql://your-rds-instance.region.rds.amazonaws.com:5432/resortdb
DB_USERNAME=dbuser
DB_PASSWORD=secure-password-here
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=resortslite-reports-prod
DB_SECRET_NAME=resortslite/db/credentials

# Redis Configuration (Amazon ElastiCache)
REDIS_HOST=your-elasticache-cluster.region.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# External Service Endpoints
PAYMENT_ENDPOINT=https://payment-service.internal:9090/charge
INVENTORY_ENDPOINT=https://inventory-service.internal:8081/rooms
NOTIFICATION_ENDPOINT=https://notification-service.internal:7070/send
REPORTS_BASE_URL=https://reports.resorts.com

# H2 Console (disable in production)
H2_CONSOLE_ENABLED=false
