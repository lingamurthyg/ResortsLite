# Environment Variables Template for PostgreSQL Configuration
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to version control

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resortdb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MIN_IDLE=5

# Hibernate Settings
DDL_AUTO=update
SHOW_SQL=false
SQL_LOG_LEVEL=INFO

# Application Endpoints
PAYMENT_ENDPOINT=http://payment-svc.internal:9090/charge
INVENTORY_ENDPOINT=http://inventory-svc.internal:8081/rooms
NOTIFICATION_ENDPOINT=http://notify.internal:7070/send

# Server Configuration
SERVER_PORT=8080

# Production Settings (uncomment and configure for production)
# DB_HOST=prod-db.example.com
# DB_PORT=5432
# DB_NAME=resortdb_prod
# DB_USERNAME=prod_user
# DB_PASSWORD=<use-secrets-manager>
# DDL_AUTO=validate
# SHOW_SQL=false
# SQL_LOG_LEVEL=WARN
