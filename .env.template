# Environment Configuration Template for GCP Deployment
# Copy this file to .env and configure with actual values

# ============================================================================
# GCP Configuration
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=resorts-reports-bucket

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8080

# ============================================================================
# Database Configuration (Cloud SQL or external database)
# ============================================================================
DB_URL=jdbc:postgresql://CLOUD_SQL_INSTANCE_IP:5432/resortdb
DB_USERNAME=sm://projects/YOUR_PROJECT_ID/secrets/db-user
DB_PASSWORD=sm://projects/YOUR_PROJECT_ID/secrets/db-pass
DB_DRIVER=org.postgresql.Driver
DB_HOST=sm://projects/YOUR_PROJECT_ID/secrets/db-host

# HikariCP Connection Pool Settings
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ============================================================================
# Redis Configuration (Memorystore for Redis)
# ============================================================================
REDIS_HOST=10.0.0.3
REDIS_PORT=6379
REDIS_PASSWORD=sm://projects/YOUR_PROJECT_ID/secrets/redis-password
REDIS_SSL=false
REDIS_TIMEOUT=2000

# Cache TTL in milliseconds (default: 1 hour)
CACHE_TTL=3600000

# ============================================================================
# Google Secret Manager Configuration
# ============================================================================
SECRET_MANAGER_ENABLED=true

# ============================================================================
# External Service Endpoints (use HTTPS)
# ============================================================================
PAYMENT_ENDPOINT=https://payment-service.example.com/charge
INVENTORY_ENDPOINT=https://inventory-service.example.com/rooms/available
NOTIFICATION_ENDPOINT=https://notification-service.example.com/send
REPORTS_BASE_URL=https://reports-service.example.com/download

# ============================================================================
# Authentication Configuration
# ============================================================================
AUTH_CREDENTIALS_PATH=sm://projects/YOUR_PROJECT_ID/secrets/auth-credentials

# ============================================================================
# H2 Console (disable in production)
# ============================================================================
H2_CONSOLE_ENABLED=false
