# ResortsLite - Cloud Environment Configuration Template
# Copy this file to .env and configure for your GCP environment

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Dynamic port binding (Cloud Run automatically sets this)
PORT=8080

# ============================================================================
# DATABASE CONFIGURATION (Google Cloud SQL or external database)
# ============================================================================
# Store credentials in Google Secret Manager in production
DATABASE_URL=jdbc:postgresql://localhost:5432/resortdb
DATABASE_USERNAME=resortuser
DATABASE_PASSWORD=changeme

# ============================================================================
# REDIS CONFIGURATION (Google Cloud Memorystore for Redis)
# ============================================================================
# Fixes cr-java-0065 (HTTP Session State) and cr-java-0067 (In-Memory Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# GOOGLE CLOUD STORAGE CONFIGURATION
# ============================================================================
# Fixes cr-java-0061, cr-java-0062, cr-java-0063 (File System Dependencies)
GCS_BUCKET_NAME=resorts-lite-storage
GCS_REPORTS_FOLDER=reports
GCS_BACKUPS_FOLDER=backups

# ============================================================================
# GOOGLE CLOUD PROJECT CONFIGURATION
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
# Credentials location (optional - auto-discovered in GCP environments)
# GCP_CREDENTIALS_LOCATION=file:/path/to/service-account-key.json

# ============================================================================
# EXTERNAL SERVICE ENDPOINTS
# ============================================================================
# Fixes cr-java-0071 (Hard-coded Environment URLs)
PAYMENT_SERVICE_URL=https://payment-svc.example.com/charge
INVENTORY_SERVICE_URL=https://inventory-svc.example.com/rooms
NOTIFICATION_SERVICE_URL=https://notify-svc.example.com/send

# ============================================================================
# REPORT DOWNLOAD CONFIGURATION
# ============================================================================
# Fixes cr-java-0071 (Hard-coded URLs) and cr-java-0088 (HTTP vs HTTPS)
REPORT_DOWNLOAD_BASE_URL=https://reports.resorts.com

# ============================================================================
# AUTHENTICATION CONFIGURATION
# ============================================================================
# Fixes cr-java-0090 (File-based Authentication)
# Use classpath: for bundled resources or gs:// for GCS
AUTH_CREDENTIALS_PATH=classpath:auth/credentials.json

# ============================================================================
# H2 CONSOLE (Development only - disable in production)
# ============================================================================
H2_CONSOLE_ENABLED=false
